            "id": "RC7-197",
            "question": "What is Jessica Lin's primary concern?",
            "options": {
              "A": "Finding a larger office facility",
              "B": "The safe transport of fragile electronic equipment",
              "C": "The total cost of the relocation",
              "D": "Hiring additional IT staff"
