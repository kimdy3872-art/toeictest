import json\
import subprocess\
\
# \uc0\u54924 \u52264  \u49444 \u51221  \u48143  \u47004 \u45924  \u49884 \u46300  \u49373 \u49457 \
session_num = 2\
topics_by_session = \{\
    1: "\uc0\u51648 \u54616 \u52384  \u50672 \u51109  \u44277 \u49324 , \u49888 \u51228 \u54408  \u49548 \u54532 \u53944 \u50920 \u50612  \u50724 \u47448 , \u54924 \u49324  \u52285 \u47549 \u44592 \u45392 \u51068 ",\
    2: "\uc0\u44277 \u54637  \u49492 \u53952 \u48260 \u49828  \u51648 \u50672 , \u54840 \u53588  \u50696 \u50557  \u48320 \u44221 , \u47932 \u47448 \u52285 \u44256  \u51116 \u44256  \u44288 \u47532 ",  # \u54924 \u52264 \u47560 \u45796  \u44368 \u52404 \
\}\
\
# 1. \uc0\u54532 \u47212 \u54532 \u53944  \u53596 \u54540 \u47551  \u48520 \u47084 \u50724 \u44592 \
with open("toeic_prompt_template.txt", "r", encoding="utf-8") as f:\
    prompt_template = f.read()\
\
# 2. \uc0\u54924 \u52264 \u48324  \u48320 \u49688  \u52824 \u54872 \
formatted_prompt = prompt_template.replace(\
    "\{SESSION_NUMBER\}", str(session_num)\
).replace("\{RANDOM_TOPICS\}", topics_by_session[session_num])\
\
# 3. \uc0\u51076 \u49884  \u54532 \u47212 \u54532 \u53944  \u54028 \u51068  \u51200 \u51109  \u54980  AGY \u49892 \u54665 \
with open("temp_prompt.txt", "w", encoding="utf-8") as f:\
    f.write(formatted_prompt)\
\
# AGY \uc0\u54840 \u52636  \u48143  \u44208 \u44284  \u54028 \u51068  \u51200 \u51109 \
subprocess.run(\
    f"agy --file temp_prompt.txt > toeic_vol_\{session_num\}.json", shell=True\
)\
print(f"\uc0\u51228  \{session_num\}\u54924 \u52264  \u47784 \u51032 \u44256 \u49324  \u49373 \u49457  \u50756 \u47308 !")\
