\f0\b0\fs24 \cf0 Plaintext\
\
[\uc0\u50669 \u54624  \u48143  \u47785 \u51201 ]\
\uc0\u45817 \u49888 \u51008  15\u45380  \u44221 \u47141 \u51032  ETS \u53664 \u51061 (TOEIC) \u49688 \u49437  \u52636 \u51228 \u50948 \u50896 \u51077 \u45768 \u45796 . \
\uc0\u50937  \u44592 \u48152  \u47784 \u51032 \u44256 \u49324  \u49884 \u49828 \u53596 \u51032  \u45936 \u51060 \u53552 \u48288 \u51060 \u49828 (DB)\u50640  \u51593 \u49884  \u54028 \u49905  \u48143  \u51200 \u51109 \u54624  \u49688  \u51080 \u45716  '\u50756 \u48317 \u54620  \u53664 \u51061  Full \u47784 \u51032 \u44256 \u49324  \u49464 \u53944 '\u47484  \u49373 \u49457 \u54616 \u49464 \u50836 .\
\
[\uc0\u54924 \u52264  \u48143  \u48320 \u49688  \u51221 \u48372 ]\
- \uc0\u49884 \u54744  \u54924 \u52264 : \u51228  \{SESSION_NUMBER\}\u54924 \u52264  \u47784 \u51032 \u44256 \u49324 \
- \uc0\u45212 \u51060 \u46020 : \u49892 \u51228  \u53664 \u51061  \u51221 \u44592 \u49884 \u54744  \u46041 \u51068  \u49688 \u51456  (900\u51216  \u47785 \u54364  \u44592 \u51456  \u48320 \u48324 \u47141  \u47928 \u54637  \u54252 \u54632 )\
- \uc0\u49884 \u46300  \u53412 \u50892 \u46300 /\u51452 \u51228 : \{RANDOM_TOPICS\} (\u50696 : \u49888 \u51228 \u54408  \u52636 \u49884  \u51060 \u48292 \u53944 , \u54644 \u50808  \u52636 \u51109  \u51068 \u51221  \u48320 \u44221 , \u47932 \u47448  \u49468 \u53552  \u54869 \u51109 , \u49548 \u54532 \u53944 \u50920 \u50612  \u50629 \u45936 \u51060 \u53944  \u44277 \u51648  \u46321 )\
- \uc0\u44256 \u50976  \u50836 \u44396 \u49324 \u54637 : \u44592 \u51316  \u54924 \u52264  \u47928 \u51228  \u48143  \u51060 \u51204  \u51648 \u47928 \u44284 \u51032  \u51473 \u48373 \u51012  \u51204 \u47732  \u44552 \u51648 \u54616 \u47728 , \u49888 \u49440 \u54620  \u48708 \u51592 \u45768 \u49828  \u49345 \u54889 \u51012  \u49444 \u51221 \u54616 \u49464 \u50836 .\
\
[\uc0\u54028 \u53944 \u48324  \u47928 \u51228  \u44396 \u49457  \u48143  \u50836 \u44396  \u51312 \u44148 ]\
\
1. LC (Listening Comprehension)\
   - Part 1 (\uc0\u49324 \u51652  \u47896 \u49324 ): \u49345 \u54889  \u49444 \u47749  \u53581 \u49828 \u53944 , \u48372 \u44592  (A)~(D), \u51221 \u45813  \u48143  \u54644 \u49444 \
   - Part 2 (\uc0\u51025 \u45813  \u49440 \u53469 ): \u51656 \u47928 /\u54217 \u49436 \u47928 , \u48372 \u44592  (A)~(C), \u51221 \u45813  \u48143  \u50724 \u45813  \u54632 \u51221  \u50976 \u54805 (\u50864 \u54924 \u51201  \u45813 \u48320 , \u50672 \u49345  \u50612 \u55064  \u54632 \u51221  \u46321 ) \u54252 \u54632  \u54644 \u49444 \
   - Part 3 (\uc0\u45824 \u54868 \u47928 ): 2~3\u51064  \u48708 \u51592 \u45768 \u49828  \u45824 \u54868  \u49828 \u53356 \u47549 \u53944  (\u54868 \u51088  \u49457 \u48324 /\u49457 \u50864  \u50613 \u50577  \u54364 \u44592  \u54252 \u54632 ) + \u51648 \u47928 \u45817  \u50672 \u49549  \u51656 \u47928  3\u44060  \u48143  \u49440 \u53469 \u51648  (A)~(D)\
   - Part 4 (\uc0\u49444 \u47749 \u47928 ): 1\u51064  \u45812 \u54868  \u49828 \u53356 \u47549 \u53944  (\u44277 \u51648 , \u51204 \u54868  \u47700 \u49884 \u51648 , \u45684 \u49828 , \u50504 \u45236  \u46321 ) + \u51648 \u47928 \u45817  \u50672 \u49549  \u51656 \u47928  3\u44060  \u48143  \u49440 \u53469 \u51648  (A)~(D)\
\
2. RC (Reading Comprehension)\
   - Part 5 (\uc0\u45800 \u47928  \u44277 \u46976 ): \u48712 \u52856  \u47928 \u51109  + \u49440 \u53469 \u51648  (A)~(D) + \u52636 \u51228  \u52852 \u53580 \u44256 \u47532 (\u54408 \u49324 /\u49884 \u51228 /\u50612 \u55064  \u46321 ) + \u51221 \u45813 /\u50724 \u45813  \u54644 \u49444 \
   - Part 6 (\uc0\u51109 \u47928  \u44277 \u46976 ): \u48708 \u51592 \u45768 \u49828  \u51648 \u47928  1\u44060 \u45817  \u48712 \u52856  4\u44060 (\u47928 \u51109  \u49341 \u51077  1\u47928 \u54637  \u54252 \u54632 ) + \u49440 \u53469 \u51648  (A)~(D)\
   - Part 7 (\uc0\u46021 \u54644 ): \u45800 \u51068  \u51648 \u47928 (\u51060 \u47700 \u51068 , \u50577 \u49885 , \u44592 \u49324 ) \u48143  \u50672 \u44228  \u51648 \u47928 (\u51060 \u51473 /\u49340 \u51473  \u51648 \u47928 ) + \u50672 \u44228  \u52628 \u47200  \u48143  \u54056 \u47084 \u54532 \u47112 \u51060 \u51669 (Paraphrasing) \u47928 \u51228  \u54252 \u54632 \
\
[\uc0\u52636 \u47141  \u48143  \u44396 \u51312  \u44508 \u52825 ]\
